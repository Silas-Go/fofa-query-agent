{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FOFA答题输出 t1-v1",
  "description": "逐题数组结构；数量、顺序、题号唯一及原文相等需对输入做跨记录检查。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "题号",
      "自然语言输入",
      "状态",
      "查询语句",
      "说明",
      "依据"
    ],
    "properties": {
      "题号": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "自然语言输入": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "状态": {
        "enum": [
          "成功",
          "输入非法",
          "条件矛盾",
          "需要澄清",
          "能力不支持",
          "依赖失败"
        ]
      },
      "查询语句": {
        "type": [
          "string",
          "null"
        ]
      },
      "说明": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "依据": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "来源",
            "依据",
            "核对日期"
          ],
          "properties": {
            "来源": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "依据": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "核对日期": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "状态": {
              "const": "成功"
            }
          },
          "required": [
            "状态"
          ]
        },
        "then": {
          "properties": {
            "查询语句": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "else": {
          "properties": {
            "查询语句": {
              "type": "null"
            }
          }
        }
      }
    ]
  }
}
